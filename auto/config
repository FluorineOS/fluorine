#!/bin/sh
set -e

lb config noauto \
  --mode debian \
  --system live \
  --distribution trixie \
  --parent-distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free-firmware" \
  --parent-archive-areas "main contrib non-free-firmware" \
  --debian-installer none \
  --bootloaders "grub-efi" \
  --uefi-secure-boot enable \
  --iso-application "FluorineOS 0.0.1" \
  --iso-publisher "FluorineOS; https://github.com/FluorineOS" \
  --iso-volume "FLUORINEOS_0_0_1" \
  --image-name "FluorineOS-0.0.1-amd64" \
  --bootappend-live "boot=live components quiet splash nvidia_drm.modeset=1 nvidia_drm.fbdev=1" \
  "${@}"
