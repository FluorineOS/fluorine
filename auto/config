#!/usr/bin/env bash
set -euo pipefail

# The VERSION file is the default image version. A release tag overrides it through
# FLUORINE_VERSION so the image name, ISO application id, and volume label always
# match the tag being built.

version="${FLUORINE_VERSION:-$(<VERSION)}"

if [[ ! "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf 'Invalid FluorineOS version: %s\n' "${version}" >&2
    exit 1
fi

volume="FLUORINEOS_$(printf '%s' "${version}" | tr '.' '_')"

lb config noauto \
  --mode debian \
  --system live \
  --distribution trixie \
  --parent-distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free-firmware" \
  --parent-archive-areas "main contrib non-free-firmware" \
  --debian-installer none \
  --bootloaders "grub-efi" \
  --uefi-secure-boot enable \
  --iso-application "FluorineOS ${version}" \
  --iso-publisher "FluorineOS; https://github.com/FluorineOS" \
  --iso-volume "${volume}" \
  --image-name "FluorineOS-${version}" \
  --bootappend-live "boot=live components quiet splash nvidia_drm.modeset=1 nvidia_drm.fbdev=1 systemd.setenv=WLR_RENDERER_ALLOW_SOFTWARE=1" \
  "$@"
