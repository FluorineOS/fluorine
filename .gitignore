# Local-only canonical reference; never commit this directory
SOURCE_OF_TRUTH/
SOURCE OF TRUTH/

# live-build build tree
/binary/
/cache/
/chroot/
/.build/

# live-build generated configuration state
/config/binary/
/config/bootstrap/
/config/chroot/
/config/common/
/config/source/

# live-build logs
/auto/build.log
*.log

# Image and package artifacts
*.iso
*.iso.sha256
*.deb
# Local package pool consumed by live-build; must be committed
!config/packages.chroot/*.deb
*.changes
*.buildinfo
*.qcow2

# OS / editor noise
.DS_Store
