#!/usr/bin/env bash
set -euo pipefail

# Hook: 0400-live-calamares-polkit
# Runs inside the live-build chroot as root during the normal hook phase.
# Grants the live session passwordless access to the installer. The Calamares
# shellprocess module removes this file from the installed system.
#
# The rule names exactly one executable. An earlier version also granted
# /usr/bin/env, which is unrestricted root for any sudo group member because
# `sudo env <command>` runs that command as root. The desktop entry no longer
# uses `sudo -E` either. The three Wayland variables Calamares needs are
# preserved with env_keep, which cannot be used to inject LD_PRELOAD into a root
# process the way an unrestricted SETENV grant could.

SUDOERS_FILE=/etc/sudoers.d/99-fluorine-live-installer

main() {
    install -d -m 0750 /etc/sudoers.d

    cat > "${SUDOERS_FILE}" <<'EOF'
# FluorineOS live session only: passwordless Calamares launch.
# Removed from the installed system by the Calamares shellprocess module.
Defaults:%sudo env_keep += "WAYLAND_DISPLAY XDG_RUNTIME_DIR XDG_SESSION_TYPE"
%sudo ALL=(ALL) NOPASSWD: /usr/bin/calamares
EOF
    chmod 0440 "${SUDOERS_FILE}"

    if command -v visudo >/dev/null 2>&1; then
        visudo -cf "${SUDOERS_FILE}"
    else
        printf 'visudo not available, skipping syntax check\n' >&2
    fi
}

main "$@"
