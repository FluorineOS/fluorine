#!/usr/bin/env bash
set -euo pipefail

# Hook: 0200-services
# Runs inside the live-build chroot as root during the normal hook phase.
# Enables the systemd units FluorineOS expects and applies the ufw policy.

enable_unit() {
    local unit="$1"

    if systemctl enable "${unit}" >/dev/null 2>&1; then
        printf 'Enabled %s\n' "${unit}"
    else
        printf 'Skipped %s: unit not available in this chroot\n' "${unit}" >&2
    fi
}

main() {
    enable_unit NetworkManager.service
    enable_unit bluetooth.service
    enable_unit greetd.service
    enable_unit ufw.service

    # power-profiles-daemon backs flr-power, the Waybar power module, and the
    # flr-ctl power entry. Debian's package enables it, and enabling it here
    # keeps the guarantee explicit.
    enable_unit power-profiles-daemon.service

    # Printing. CUPS is socket activated, so enabling the service alone does
    # not keep a daemon resident until something prints. avahi-daemon is what
    # makes driverless network printers discoverable over mDNS, and it is also
    # what resolves the .local names printers advertise.
    enable_unit cups.service
    enable_unit avahi-daemon.service

    if command -v ufw >/dev/null 2>&1; then
        ufw default deny incoming
        ufw default allow outgoing

        # avahi-daemon needs inbound multicast DNS, and without it driverless
        # printer discovery silently finds nothing: avahi answers on 5353/udp
        # and the reply is an inbound packet the default deny rule drops. The
        # avahi package ships no ufw application profile, so the port is named
        # directly. This is the only inbound port the image opens.
        ufw allow 5353/udp comment 'mDNS service discovery'
        # Enabling inside the chroot only records the policy; the service
        # starts on first boot.
        ufw --force enable || printf 'ufw: enable deferred to first boot\n' >&2
    else
        printf 'ufw is not installed, skipping firewall policy\n' >&2
    fi
}

main "$@"
