#!/usr/bin/env bash
set -euo pipefail

# Hook: 0100-branding
# Runs inside the live-build chroot as root during the normal hook phase.
# Owns the distribution identity files and the default hostname.

main() {
    cat > /etc/os-release <<'EOF'
PRETTY_NAME="FluorineOS 0.4.0 (Trixie)"
NAME="FluorineOS"
VERSION="0.4.0"
VERSION_ID="0.4.0"
ID=fluorineos
ID_LIKE=debian
HOME_URL="https://github.com/FluorineOS"
SUPPORT_URL="https://github.com/FluorineOS/fluorine/issues"
BUG_REPORT_URL="https://github.com/FluorineOS/fluorine/issues"
EOF
    chmod 0644 /etc/os-release

    printf '%s\n' 'FluorineOS 0.4.0 \n \l' > /etc/issue
    chmod 0644 /etc/issue

    printf '%s\n' 'fluorine' > /etc/hostname
    chmod 0644 /etc/hostname

    if command -v plymouth-set-default-theme >/dev/null 2>&1 &&
        [ -d /usr/share/plymouth/themes/fluorine ]; then
        plymouth-set-default-theme -R fluorine
    else
        printf 'Plymouth theme fluorine not available, skipping\n' >&2
    fi

    # GRUB can only read from the boot partition, so the packaged theme has to
    # be staged under /boot before the menu is generated.
    if [ -d /usr/share/grub/themes/fluorine ] && [ -d /boot/grub ]; then
        mkdir -p /boot/grub/themes
        rm -rf /boot/grub/themes/fluorine
        cp -a /usr/share/grub/themes/fluorine /boot/grub/themes/fluorine
        # The live image menu comes from config/bootloaders/grub-pc, and the
        # installer rewrites the target GRUB config, so this regeneration only
        # matters for a chroot that can see the build device. live-build mounts
        # /proc, /sys, and /dev/pts but not /dev, so grub-probe legitimately
        # cannot resolve / here; that must not abort the image build.
        if command -v update-grub >/dev/null 2>&1; then
            update-grub ||
                printf 'update-grub skipped: no device for / in the build chroot\n' >&2
        fi
    fi
}

main "$@"
