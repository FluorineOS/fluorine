fluorine-keyring

# LUKS2 root unlocking in the initramfs; the crypttab and initramfs modules
# ask for it. Firmware, microcode, and the rest of the device support live in
# hardware.list.chroot.
cryptsetup-initramfs

# Btrfs snapshot management. The installer creates the @, @home, and @snapshots
# subvolumes and flr-snapshot drives snapper from the desktop. btrfs-progs
# itself is declared with the installer filesystem tools, since both lists are
# part of the same image and duplicating it here only obscures ownership.
snapper
